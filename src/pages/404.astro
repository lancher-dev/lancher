---
import Layout from "@lancher-dev/jaad/layouts/Page.astro";
---

<Layout title="404" description="The page you're looking for doesn't exist.">
  <div class="jaad-not-found">
    <h1 class="jaad-not-found-title">404</h1>
    <p class="jaad-not-found-text">
      <i>Oops!</i> The page you're looking for doesn't exist.
    </p>
    <a href="/">Go back to the homepage</a>
  </div>
</Layout>

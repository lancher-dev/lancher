---
import Layout from "@jaamd/jaad/layouts/Page.astro";
import ArrowRight from "phosphor-astro/ArrowRight.astro";
import Check from "phosphor-astro/Check.astro";
import Copy from "phosphor-astro/Copy.astro";
import Terminal from "../components/Terminal.astro";

const install = "curl -fsSL https://lancher.dev/install.sh | sh";
---

<Layout bare class="home">
  <section
    class="jaad-chrome flex flex-wrap items-center gap-x-12 gap-y-10 py-8"
    aria-labelledby="home-title"
  >
    <div class="flex min-w-0 flex-[1_1_22rem] flex-col gap-5">
      <h1
        id="home-title"
        class="text-foreground-bright m-0 font-sans text-[2.75rem] leading-[1.1] font-bold tracking-[-0.02em] max-sm:text-[2.1rem]"
      >
        Start from a template.{" "}
        <span class="text-primary">Save what you build.</span>
      </h1>
      <p class="text-foreground-muted m-0 text-[17px] leading-[1.6]">
        lancher is a local project-template manager. Create a project from a
        template, make it yours, and save it back as a new template for next
        time.
      </p>
      <div
        class="border-border-dark bg-background-secondary flex items-center gap-2.5 rounded-lg border py-1 pr-1 pl-4"
        role="group"
        aria-label="Install command"
      >
        <code class="text-primary-light before:text-primary min-w-0 flex-1 overflow-x-auto bg-transparent font-mono text-[13.5px] whitespace-nowrap before:content-['$_']">
          {install}
        </code>
        <button
          type="button"
          class="text-foreground-muted hover:bg-background-tertiary hover:text-foreground-bright flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-md"
          data-copy={install}
          aria-label="Copy the install command"
          title="Copy"
        >
          <Copy data-copy-icon width="18" height="18" aria-hidden="true" />
          <Check
            data-copied-icon
            class="hidden"
            width="18"
            height="18"
            aria-hidden="true"
          />
        </button>
      </div>
      <a
        href="/docs/getting-started/installation"
        class="inline-flex items-center gap-1.5 self-start text-[14px]"
      >
        <span>Or with completion: Homebrew, APT, AUR</span>
        <ArrowRight width="14" height="14" aria-hidden="true" />
      </a>
    </div>

    <div class="min-w-0 flex-[1_1_36rem]">
      <Terminal />
    </div>
  </section>
</Layout>

<style is:global>
  body.home .jaad-main-bare {
    display: flex;
    align-items: center;
  }

  body.home .term {
    --term-rows: 18;
  }

  @media (max-height: 760px) {
    body.home .term {
      --term-rows: 15;
    }
  }

  @media (max-height: 640px) {
    body.home .term {
      --term-rows: 12;
    }
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-copy]",
  )) {
    const copyIcon = button.querySelector<SVGElement>("[data-copy-icon]")!;
    const copiedIcon = button.querySelector<SVGElement>("[data-copied-icon]")!;
    const label = button.getAttribute("aria-label")!;
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy!);
      copyIcon.classList.add("hidden");
      copiedIcon.classList.remove("hidden");
      button.setAttribute("aria-label", "Copied");
      setTimeout(() => {
        copyIcon.classList.remove("hidden");
        copiedIcon.classList.add("hidden");
        button.setAttribute("aria-label", label);
      }, 1600);
    });
  }
</script>
